# Zkopíruj do .env a doplň. Bez klíče běží agent v režimu "keyword" (jen klíčová slova).
FEATHERLESS_API_KEY=

# Apify token pro stav "seed" (první reels k tématu přes scraper). Viz docs/apify-seed.md
APIFY_TOKEN=

# Konfigurace cíle podle WORKFLOW.md (sekce 3). Bez ní se cíl odvodí z GOAL (účet real → režim safe).
# GOAL_FILE=goals/fitness-2026-11-13.json

# Cíl feedu (dá se zadat i jako argument: npm start -- "auta a motorsport")
GOAL=auta, superauta a motorsport

# Prohlížeč: chrome | msedge | chromium (výchozí: Chrome, když je nainstalovaný, jinak Edge)
# BROWSER_CHANNEL=msedge

# Rychlé iterování (pauzy a délky fází × 0,15): npm start -- --iterate …
# TIME_SCALE=0.15

# Bezpečný první běh: jen kouká a přeskakuje, nic nelajkuje ani neukládá.
DRY_RUN=1

# TEXT_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# KEYWORDS=auta,cars,bmw,porsche,ferrari,motorsport

