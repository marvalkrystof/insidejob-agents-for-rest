# Domovník: copy this file to .env and fill in the values. Never commit .env.
# Verify everything with: yarn check:apis

# Golemio (Prague parking, P+R occupancy, tariffs).
# Free self-service key: https://api.golemio.cz/api-keys/auth/sign-up
# Sent as the X-Access-Token header.
GOLEMIO_API_KEY=

# TomTom Routing (travel time with live traffic, arriveAt). Free tier, no card.
# Create a key in the TomTom developer portal: https://developer.tomtom.com/
TOMTOM_API_KEY=

# Featherless.ai (LLM, OpenAI-compatible API at https://api.featherless.ai/v1).
# Key from your Featherless account.
FEATHERLESS_API_KEY=
# Optional, defaults to Qwen/Qwen3-30B-A3B-Instruct-2507
FEATHERLESS_MODEL=

# Telegram bot token from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Leave empty at first: send any message to your bot, run `yarn check:apis`,
# it prints the chat id to put here.
TELEGRAM_CHAT_ID=

# Apify API token from the Apify Console (API tokens / integrations).
APIFY_TOKEN=
